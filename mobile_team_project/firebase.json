rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rule for the 'users' collection
    match /users/{userId} {
      // Allow reads and writes ONLY if the user is logged in
      // AND their UID matches the document ID they are accessing.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Add rules for other collections here if needed
  }
}

// Add this inside match /databases/{database}/documents { ... }
match /organizations/{orgId} {
  allow read: if request.auth != null; // Allow any logged-in user to read organization data
  // Add write rules if needed later (e.g., only admins can write)
}
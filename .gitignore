# NOTE: Patterns must start at column 0. Git does NOT strip leading whitespace
# from ignore patterns, so an indented rule silently matches nothing.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart related
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/ios/.symlinks/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/

# Node (this is a Flutter project - no npm dependencies belong here)
**/node_modules/

# Android related
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/key.properties
**/android/app/src/main/assets/flutter_assets/kernel_blob.bin

# iOS related
**/ios/Pods/
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/GeneratedPluginRegistrant.h
**/ios/Flutter/GeneratedPluginRegistrant.m
**/ios/Runner.xcworkspace/xcuserdata/
**/ios/Runner.xcodeproj/project.xcworkspace/
**/ios/Runner.xcodeproj/xcuserdata/

# VS Code related
.vscode/

# Firebase related (IMPORTANT - Do not commit sensitive keys)
# Paths are **/-prefixed because the Flutter app lives in mobile_team_project/,
# not at the repo root. Root-anchored paths (/android/...) would never match.
# These carry the release signing certificate SHA-1 and OAuth client config.
**/android/app/google-services.json
**/ios/Runner/GoogleService-Info.plist
**/macos/Runner/GoogleService-Info.plist
#
# lib/firebase_options.dart is deliberately NOT ignored. The apiKey values in it
# are public client identifiers that ship inside every app binary - they are not
# secrets, and Google documents them as such. What actually protects the project
# is firestore.rules plus API key restrictions in the Google Cloud console.
# Ignoring it would only break every teammate's build on a fresh clone.

# Local environment configuration. The real .env stays out of the repository so
# each environment supplies its own; .env.example is the committed template and
# must be re-included, because the patterns above it would otherwise match.
.env
.env.*
*.env
!.env.example
!**/.env.example

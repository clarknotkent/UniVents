# Copy this file to `.env` and adjust for your environment:
#
#   cp .env.example .env
#
# IMPORTANT - this file is NOT a secret store.
#
# Flutter bundles `.env` into the application as an asset, so anything placed
# here ships inside the binary and can be extracted from it by anyone. Treat
# every value below as public. Real secrets belong on a server (a Cloud
# Function using the Admin SDK), never in a client app.
#
# What this file IS for: keeping environment-dependent configuration in one
# declared place instead of scattered through Dart source, so pointing the app
# at a different university, Firebase project, or OAuth client is a config
# change rather than a code change.
#
# The application falls back to the defaults compiled into
# lib/app_config.dart when a value is absent or `.env` is missing entirely,
# so a fresh clone still runs without setup.

# Email domain permitted to sign in. Must match the domain enforced in
# firestore.rules - changing it here alone does NOT change who can read data,
# because the server-side rule is the actual restriction.
AUTH_EMAIL_DOMAIN=addu.edu.ph

# OAuth 2.0 *web* client ID (client_type 3) for the Firebase project.
# Android requires this explicitly because the com.google.gms.google-services
# Gradle plugin is not applied, so there is no generated default_web_client_id
# string resource for the Google Sign-In plugin to read.
# A public client identifier, exactly like the API keys in firebase_options.dart.
GOOGLE_SERVER_CLIENT_ID=1097036028807-e1ik2lc81l701vccr675g7f2ribh9rh8.apps.googleusercontent.com
